#!/usr/bin/env bash
# The resolver spike (DESIGN 7.2): build core for real with mmdebstrap at a snapshot and write the
# resulting dpkg status, to compare with the plan's package set.
#   scripts/spike-core --snapshot ID --out FILE [--tag TAG] [PACKAGE...]
#   scripts/spike-core --debian ID --debian-security ID --out FILE [--tag TAG] [PACKAGE...]
# --snapshot ID reads both archives at one ID; --debian and --debian-security give each archive its own, as
# a plan's `snapshots` do.
# FILE is a JSON sorted list of [name, version, architecture]; FILE.log is mmdebstrap's output.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "usage: scripts/spike-core (--snapshot ID | --debian ID --debian-security ID) --out FILE [--tag TAG] [PACKAGE...]" >&2
  exit 2
}

main=""
security=""
out=""
tag=""
packages=()
while [ $# -gt 0 ]; do
  case "$1" in
    --snapshot) [ $# -ge 2 ] || usage; main="$2"; security="$2"; shift 2 ;;
    --debian) [ $# -ge 2 ] || usage; main="$2"; shift 2 ;;
    --debian-security) [ $# -ge 2 ] || usage; security="$2"; shift 2 ;;
    --out) [ $# -ge 2 ] || usage; out="$2"; shift 2 ;;
    --tag) [ $# -ge 2 ] || usage; tag="$2"; shift 2 ;;
    -*) usage ;;
    *) packages+=("$1"); shift ;;
  esac
done
{ [ -n "$main" ] && [ -n "$security" ] && [ -n "$out" ]; } || usage

if [ -z "$tag" ]; then
  tag="debian-image-factory-builder:$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["debian_snapshot"])' "$root/lock.json")"
fi

include=""
if [ "${#packages[@]}" -gt 0 ]; then
  include="$(IFS=,; echo "${packages[*]}")"
fi

# The same three suites the builder image uses, each archive at its own snapshot (see builder/Dockerfile).
# shellcheck disable=SC2016  # the script is for the container's shell: nothing expands here
inner='
set -eu
main="$1"; security="$2"; include="$3"
work=$(mktemp -d)
printf "%s\n" \
  "Types: deb" \
  "URIs: http://snapshot.debian.org/archive/debian/${main}/" \
  "Suites: trixie trixie-updates" \
  "Components: main" \
  "" \
  "Types: deb" \
  "URIs: http://snapshot.debian.org/archive/debian-security/${security}/" \
  "Suites: trixie-security" \
  "Components: main" > "$work/spike.sources"
set -- --mode=root --variant=apt --verbose --aptopt="Acquire::Check-Valid-Until \"false\""
if [ -n "$include" ]; then set -- "$@" --include="$include"; fi
mmdebstrap "$@" trixie "$work/rootfs" "$work/spike.sources" >&2
dpkg-query --admindir="$work/rootfs/var/lib/dpkg" -W -f "\${db:Status-Status}\t\${Package}\t\${Version}\t\${Architecture}\n"
'

mkdir -p "$(dirname "$out")"
docker run --rm --privileged "$tag" bash -c "$inner" spike "$main" "$security" "$include" 2>"$out.log" |
  python3 -c '
import json, sys
rows = sorted(f[1:] for f in (line.rstrip("\n").split("\t") for line in sys.stdin if line.strip()) if f[0] == "installed")
print(json.dumps(rows, indent=2))
' > "$out"
echo "$out: $(python3 -c 'import json, sys; print(len(json.load(open(sys.argv[1]))))' "$out") packages"
