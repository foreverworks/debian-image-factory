#!/usr/bin/env bash
# Every test tier, runnable locally with one command (DESIGN 12): nobody waits on CI to learn what a change broke.
#
#   scripts/test static        ruff, ruff format, mypy, check-ignores, shellcheck (scripts, hooks, the Action's steps)
#   scripts/test unit          the unit tests (seconds, no network, no root)
#   scripts/test integration   the slow tests, DIF_INTEGRATION=1 (network, docker)
#   scripts/test boot          only the tests that boot images: the boot checks' and M5's acceptance (QEMU;
#                              KVM when /dev/kvm opens)
#   scripts/test incus         builds core, incus-base and an Incus child, runs every check on them (the
#                              Incus ones in scripts/incus-vm), and requires them all to pass
#   scripts/test matrix        the unit tier in docker on the Python floor and on the newest stable
#   scripts/test all           static, unit and matrix (add integration by naming it)
#
# The unit, integration and boot tiers run their test classes in parallel (scripts/run-tests): longest class first,
# each worker's log in dist/test-<tier>/ and the failures of all of them printed together at the end. Options after the tier go to it:
#
#   -j N (or DIF_JOBS=N)   N workers instead of the default, the smaller of the CPUs and the free memory over
#                          a per-tier budget (unit 0.5 GiB, integration 3, boot 6); -j 1 runs serially
#   --shard I/N            only the I-th of N shards of the tier, balanced by the measured time of each class
#                          (CI runs the integration tier as a matrix of shards)
#   --measure              rewrite tests/durations.json, the class timings the schedule is built from
#   --list                 print the schedule and run nothing
#
# Tools come from PATH (what CI installs from requirements-dev.txt) or, when missing, from uvx at the
# version requirements-dev.in pins. Test output goes to dist/test-<tier>.log, then is printed.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
export PYTHONDONTWRITEBYTECODE=1

# One version pin, read from requirements-dev.in.
pinned() { grep -m1 "^$1==" requirements-dev.in | cut -d= -f3; }

# tool <name> <arguments...>: the tool on PATH, else the pinned one through uvx.
tool() {
    local name=$1
    shift
    if command -v "$name" >/dev/null 2>&1; then
        "$name" "$@"
    else
        uvx "$name@$(pinned "$name")" "$@"
    fi
}

# The scripts with a shebang, whatever their suffix: ruff and mypy only see .py files by themselves.
scripts_with() {
    local f
    for f in scripts/* examples/*; do
        [ -f "$f" ] && head -n1 "$f" | grep -Eq "$1" && printf '%s\n' "$f"
    done
    return 0
}

static() {
    local python_scripts shell_scripts
    mapfile -t python_scripts < <(scripts_with '^#!.*python')
    mapfile -t shell_scripts < <(scripts_with '^#!.*(ba|da)?sh')
    echo "== ruff check"
    tool ruff check . "${python_scripts[@]}"
    echo "== ruff format --check"
    tool ruff format --check . "${python_scripts[@]}"
    echo "== mypy"
    tool mypy
    # a script is module __main__ to mypy: one run each, or two of them clash
    tool mypy scripts/incus-vm
    tool mypy scripts/action-support
    tool mypy scripts/run-tests
    echo "== check-ignores"
    python3 scripts/check-ignores
    echo "== shellcheck"
    if [ "${#shell_scripts[@]}" -gt 0 ]; then
        tool shellcheck "${shell_scripts[@]}"
    fi
    echo "== shellcheck: the run steps of the Action and the nightly workflow"
    # each step's script is written to its own file; a step that puts a ${{ }} expression into its script fails here
    python3 scripts/action-support shell dist/action-shell action.yml .github/workflows/nightly.yml
    tool shellcheck dist/action-shell/*.sh
}

# parallel <tier> [run-tests options...]: the tier's test classes across processes (scripts/run-tests), whose
# logs are in dist/test-<tier>/ and all together in dist/test-<tier>.log.
parallel() {
    local tier=$1
    shift
    mkdir -p dist
    PYTHONPATH=src:.vendor python3 scripts/run-tests "$tier" "$@"
}

# The unit tier on the floor (3.13, Debian 13's python3) and the newest stable, in docker. The worktree
# is mounted read-only and copied, without dist and .git, to a scratch repository inside the container, so
# the run writes nothing back and build-pyz has a commit to take its time stamps from.
matrix() {
    local version
    for version in 3.13 3.15; do
        echo "== unit tier on Python $version"
        docker run --rm -v "$root:/source:ro" "python:$version" bash -ec '
            # the archive tests verify signatures with gpgv, which apt in Debian 13 no longer pulls in
            command -v gpgv >/dev/null || { apt-get -qq update && apt-get -qq install -y gpgv; } >/dev/null
            # dist holds the scratch of other runs (an integration build may be writing there), .git a worktree link
            mkdir /work
            tar -C /source --exclude=./.git --exclude=./dist -cf - . | tar -C /work -xf -
            git config --global --add safe.directory /work
            cd /work
            git init -q
            git add -A
            git -c user.name=test -c user.email=test@example.com commit -qm test
            scripts/test unit
        '
    done
}

# The Incus boot contract (DESIGN 14's M4): core, incus-base and an Incus child of it are built from a copy
# of the example definition with the default builder image (scripts/builder build), every check runs on
# the host, then incus-boot and two-clones run again on an Incus host in scripts/incus-vm (the last
# result of a check wins), and verify --require-checks must pass for all three. The build is in
# dist/incus, the log in dist/test-incus.log.
incus_tier() {
    local work=dist/incus log=dist/test-incus.log status=0
    mkdir -p dist
    # a docker build can leave files this user cannot delete
    if [ -e "$work" ]; then docker run --rm -v "$root/dist:/w" debian:trixie rm -rf /w/incus; fi
    mkdir -p "$work"
    cp -a examples "$work/examples"
    cat >>"$work/examples/factory.toml" <<'TOML'

[images.incus-tools]
kind = "incus"
parent = "incus-base"
packages = ["jq"]
hooks = ["hooks/incus-tools.sh"]
TOML
    printf '#!/bin/sh\nset -eu\njq --version > /usr/local/share/incus-tools-hook\n' >"$work/examples/hooks/incus-tools.sh"
    chmod 755 "$work/examples/hooks/incus-tools.sh"
    incus_steps "$work" >"$log" 2>&1 || status=$?
    cat "$log"
    return "$status"
}

# Called as `incus_steps ... || status=$?`, where bash ignores set -e: every step returns on failure itself.
incus_steps() {
    local work=$1 snapshot artifact status=0
    local defs=(--lock "$work/examples/lock.json" --definition "$work/examples/factory.toml")
    snapshot=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["debian_snapshot"])' "$work/examples/lock.json") || return
    dif() { PYTHONPATH=src:.vendor python3 -m debian_image_factory "$@"; }
    dif plan "${defs[@]}" --out "$work/plan.json" || return
    dif fetch "$work/plan.json" || return
    dif build "$work/plan.json" --out "$work/out" --image core --image incus-base --image incus-tools "${defs[@]}" || return
    echo "== every check, on this host (the Incus ones are not run here: no Incus host)"
    dif test "$work/out" --definition "$work/examples/factory.toml" || true
    echo "== incus-boot and two-clones, on an Incus host in a VM"
    scripts/incus-vm --snapshot "$snapshot" --share "$root:repo" -- sh -ec \
        "cd /mnt/repo && PYTHONPATH=src:.vendor python3 -m debian_image_factory test $work/out --check incus-boot --check two-clones" || return
    echo "== every required check passed"
    for artifact in "$work"/out/core-*.tar.gz "$work"/out/*.incus.tar.gz; do
        dif verify "$artifact" --require-checks "${defs[@]}" || status=1
    done
    return "$status"
}

tier=${1:-}
shift || true
python3 scripts/vendor-input-lock
case "$tier" in
static) static ;;
unit | integration | boot) parallel "$tier" "$@" ;;
matrix) matrix ;;
incus) incus_tier ;;
all)
    static
    parallel unit
    matrix
    ;;
*)
    sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
