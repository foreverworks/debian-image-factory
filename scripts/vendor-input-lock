#!/usr/bin/env python3
"""Fetch the input-lock release lock.json names, check its sha256, and unpack its package into .vendor/.

The factory never re-implements the lock: it imports input-lock at the pinned version, from
.vendor/ while developing and from inside its own .pyz once built. Standard library only, so it
runs before anything else is installed.

    scripts/vendor-input-lock            fetch (or reuse the cached file) and unpack
    scripts/vendor-input-lock --print    print the path of the verified .pyz
"""

import hashlib
import json
import shutil
import sys
import urllib.request
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CACHE = ROOT / ".vendor"


def main(argv: list[str]) -> int:
    entry = json.loads((ROOT / "lock.json").read_text())["inputs"]["input-lock"]
    version, expected = entry["version"], entry["sha256"]
    url = entry["url"].replace("{version}", version)
    pyz = CACHE / f"input-lock-{version}.pyz"
    CACHE.mkdir(exist_ok=True)
    if not pyz.exists() or hashlib.sha256(pyz.read_bytes()).hexdigest() != expected:
        if not url.startswith("https://"):
            raise SystemExit(f"lock.json: input-lock url is not https: {url}")
        with urllib.request.urlopen(url, timeout=60) as response:
            data = response.read()
        actual = hashlib.sha256(data).hexdigest()
        if actual != expected:
            raise SystemExit(f"input-lock {version}: sha256 {actual} is not the pinned {expected}")
        partial = pyz.with_suffix(".partial")
        partial.write_bytes(data)
        partial.replace(pyz)
    if "--print" in argv:
        print(pyz)
        return 0
    target = CACHE / "input_lock"
    stamp = CACHE / "input_lock.version"
    if not (target.is_dir() and stamp.exists() and stamp.read_text() == expected):
        shutil.rmtree(target, ignore_errors=True)
        with zipfile.ZipFile(pyz) as archive:
            for name in archive.namelist():
                if name.startswith("input_lock/"):
                    archive.extract(name, CACHE)
        stamp.write_text(expected)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
