#!/usr/bin/env python3
"""Run a test tier's test classes across processes, longest first (scripts/test calls this).

    scripts/run-tests TIER [-j N] [--shard I/N] [--measure] [--list]

TIER is `unit`, `integration` or `boot`. A test class is the unit of work: its tests share the
class's fixtures (setUpClass builds an image once for all of them), so a class runs whole, in one
process. The classes of the tier are weighed from tests/durations.json (what the last `--measure`
run took), sorted longest first, and handed to N workers, N = the CPUs by default (`-j N` or
DIF_JOBS overrides), capped by memory: N = min(CPUs, available memory / the tier's per-job budget), the
available memory being the tighter of /proc/meminfo's MemAvailable and the cgroup's memory.max less
memory.current. The budget is 0.5 GiB a job for unit, 3 for integration and 6 for boot (QEMU and mmdebstrap);
the chosen N and why are printed. A worker takes the next class or batch of small ones when it is free, so one
slow estimate does not leave the others idle.

    --shard I/N    run only the I-th of N shards (1-based) of the tier, split by weight so the shards
                   take about the same time; every shard is parallel inside, so CI's wall clock is the
                   longest shard
    --measure      rewrite tests/durations.json from this run (a quiet machine, `-j 1`, gives the
                   cleanest numbers; a parallel run's are inflated by contention and still schedule well)
    --list         print the plan (the shard's classes, their weights, the batches) and run nothing

UNITTEST_MODULES (module or class names, space separated) replaces the tier's list.

Each worker's log is dist/test-<tier>/job-<k>.log and its result job-<k>.json; dist/test-<tier>.log is
all the logs; the failures of every worker are printed together at the end. The exit status is non-zero
when any test failed, or a worker died, or a class could not be loaded.
"""

import argparse
import concurrent.futures
import dataclasses
import json
import os
import subprocess
import sys
import threading
import time
import unittest
from collections.abc import Mapping, Sequence
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DURATIONS = ROOT / "tests" / "durations.json"
TIERS = ("unit", "integration", "boot")
BOOT_MODULES = ("tests.integration.test_boot_checks", "tests.integration.test_m5_acceptance")
TOP = 15
"""How many of the slowest classes and tests the summary lists."""
GIB = 1024**3
BUDGETS = {"unit": GIB // 2, "integration": 3 * GIB, "boot": 6 * GIB}
"""Memory one worker of a tier may need, in bytes: a unit class is small, an integration class runs mmdebstrap and
docker builds, a boot class a QEMU guest on top."""
CGROUP = Path("/sys/fs/cgroup")


@dataclasses.dataclass(frozen=True, slots=True)
class Job:
    """One worker process's share: the classes it runs, in order, and their summed weight."""

    index: int
    names: tuple[str, ...]
    weight: float


@dataclasses.dataclass(frozen=True, slots=True)
class Report:
    """What a worker wrote to its result file."""

    units: dict[str, float]
    tests: dict[str, float]
    ran: int
    skipped: int
    failures: tuple[str, ...]
    wall: float


@dataclasses.dataclass(frozen=True, slots=True)
class Outcome:
    """A finished job: its report, or why it has none."""

    job: Job
    report: Report | None
    status: int
    log: Path
    seconds: float


# --- pure: weights, shards and batches ---------------------------------------------------------------------------


def lpt(weights: Mapping[str, float], bins: int) -> list[list[str]]:
    """Longest processing time first: each name, heaviest first, into the lightest bin so far (ties by name)."""
    loads = [0.0] * bins
    packed: list[list[str]] = [[] for _ in range(bins)]
    for name in sorted(weights, key=lambda one: (-weights[one], one)):
        lightest = min(range(bins), key=lambda index: (loads[index], index))
        packed[lightest].append(name)
        loads[lightest] += weights[name]
    return packed


def weigh(names: Sequence[str], known: Mapping[str, float]) -> dict[str, float]:
    """A weight per name: the measured seconds, or the mean of the measured ones (1 s when none) for a new class."""
    mean = sum(known.values()) / len(known) if known else 1.0
    return {name: max(known.get(name, mean), 0.01) for name in names}


def shard_of(weights: Mapping[str, float], index: int, count: int) -> dict[str, float]:
    """The classes of shard `index` of `count` (1-based): the same split in every process that asks."""
    chosen = lpt(weights, count)[index - 1]
    return {name: weights[name] for name in chosen}


def batches(weights: Mapping[str, float], workers: int) -> list[Job]:
    """Jobs, longest first: a heavy class alone, the light ones packed together so a process start is not
    paid per class. A batch holds at most a quarter of one worker's even share of the work."""
    limit = sum(weights.values()) / (4 * workers)
    ordered = sorted(weights, key=lambda one: (-weights[one], one))
    jobs: list[Job] = []
    names: list[str] = []
    load = 0.0
    for name in ordered:
        if names and load + weights[name] > limit:
            jobs.append(Job(len(jobs), tuple(names), load))
            names, load = [], 0.0
        names.append(name)
        load += weights[name]
    if names:
        jobs.append(Job(len(jobs), tuple(names), load))
    return jobs


def meminfo_available(text: str) -> int | None:
    """MemAvailable of /proc/meminfo in bytes, or None when the file does not say."""
    for line in text.splitlines():
        if line.startswith("MemAvailable:"):
            fields = line.split()
            if len(fields) >= 2 and fields[1].isdigit():
                return int(fields[1]) * 1024
    return None


def cgroup_headroom(limit: str | None, current: str | None) -> int | None:
    """What the cgroup still has: memory.max less memory.current, in bytes. None when there is no limit (`max`,
    or the files are absent or unreadable); 0 when the group is at or over its limit."""
    if limit is None or current is None:
        return None
    if not (limit.strip().isdigit() and current.strip().isdigit()):
        return None
    return max(int(limit) - int(current), 0)


def tighter(first: int | None, second: int | None) -> int | None:
    """The smaller of two optional amounts; the other when one is unknown."""
    known = [one for one in (first, second) if one is not None]
    return min(known) if known else None


def memory_cap(available: int | None, budget: int) -> int | None:
    """How many workers of `budget` bytes fit in `available` bytes, at least one; None when memory is unknown."""
    return None if available is None else max(available // budget, 1)


def choose_workers(cpus: int, available: int | None, budget: int) -> tuple[int, str]:
    """The default worker count, min(cpus, memory cap), and the sentence saying why."""
    if available is None:
        return cpus, f"{cpus} workers: one per CPU (available memory unknown)"
    cap = memory_cap(available, budget) or 1
    count = min(cpus, cap)
    limit = "memory" if cap < cpus else "CPUs"
    return count, (
        f"{count} workers: {limit} is the limit ({cpus} CPUs, {available / GIB:.1f} GiB available, "
        f"{budget / GIB:.1f} GiB a job)"
    )


def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return None


def available_memory() -> int | None:
    """The memory a new worker can count on, in bytes: the tighter of the host's MemAvailable and the cgroup's room."""
    meminfo = read_text(Path("/proc/meminfo"))
    host = meminfo_available(meminfo) if meminfo is not None else None
    return tighter(host, cgroup_headroom(read_text(CGROUP / "memory.max"), read_text(CGROUP / "memory.current")))


def parse_shard(text: str) -> tuple[int, int]:
    """`I/N` as (I, N), 1 <= I <= N."""
    first, _, second = text.partition("/")
    if not (first.isdigit() and second.isdigit()) or not 1 <= int(first) <= int(second):
        raise ValueError(f"--shard wants I/N with 1 <= I <= N, not {text!r}")
    return int(first), int(second)


def read_durations(text: str) -> dict[str, float]:
    """tests/durations.json: {"units": {class name: seconds}}."""
    data: object = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError("durations.json is not an object")
    units = data.get("units")
    if not isinstance(units, dict):
        raise ValueError("durations.json has no units object")
    found: dict[str, float] = {}
    for name, seconds in units.items():
        if not isinstance(name, str) or not isinstance(seconds, int | float) or isinstance(seconds, bool):
            raise ValueError(f"durations.json: bad entry {name!r}")
        found[name] = float(seconds)
    return found


def parse_report(text: str) -> Report:
    """A worker's result file, every field checked."""
    data: object = json.loads(text)
    if not isinstance(data, dict):
        raise ValueError("report is not an object")
    units, tests = data.get("units"), data.get("tests")
    ran, skipped, failures, wall = data.get("ran"), data.get("skipped"), data.get("failures"), data.get("wall")
    if not (isinstance(units, dict) and isinstance(tests, dict)):
        raise ValueError("report: units and tests must be objects")
    if not (isinstance(ran, int) and isinstance(skipped, int) and isinstance(wall, int | float)):
        raise ValueError("report: ran, skipped and wall must be numbers")
    if not (isinstance(failures, list) and all(isinstance(one, str) for one in failures)):
        raise ValueError("report: failures must be a list of strings")
    return Report(
        units={str(name): float(seconds) for name, seconds in units.items()},
        tests={str(name): float(seconds) for name, seconds in tests.items()},
        ran=ran,
        skipped=skipped,
        failures=tuple(str(one) for one in failures),
        wall=float(wall),
    )


# --- discovery -----------------------------------------------------------------------------------------------------


def tier_modules(tier: str) -> list[str]:
    """The test modules of a tier, as dotted names. The integration tier is the modules under tests/integration:
    the unit tier runs the rest, and the integration modules skip themselves without DIF_INTEGRATION=1."""
    if tier == "boot":
        return list(BOOT_MODULES)
    folder = ROOT / "tests" / "integration" if tier == "integration" else ROOT / "tests"
    prefix = "tests.integration" if tier == "integration" else "tests"
    return [f"{prefix}.{path.stem}" for path in sorted(folder.glob("test_*.py"))]


def classes_of(modules: Sequence[str]) -> list[str]:
    """Every test class (one that holds tests) defined in the modules, as `module.Class`. A name that does not
    import as a module (a class name, or a broken module) stays in the list as it is, so its worker loads it
    and reports whatever is wrong."""
    loader = unittest.TestLoader()
    names: list[str] = []
    for module_name in modules:
        try:
            module = __import__(module_name, fromlist=["_"])
        except Exception:  # whatever a broken module raises, its worker reports it properly
            names.append(module_name)
            continue
        for attribute in sorted(vars(module)):
            value = getattr(module, attribute)
            if (
                isinstance(value, type)
                and issubclass(value, unittest.TestCase)
                and value.__module__ == module_name
                and loader.getTestCaseNames(value)
            ):
                names.append(f"{module_name}.{value.__qualname__}")
    return names


def selected(tier: str) -> list[str]:
    """The tier's classes, or those of the modules (or the classes) UNITTEST_MODULES names."""
    override = os.environ.get("UNITTEST_MODULES", "").split()
    return list(dict.fromkeys(classes_of(override or tier_modules(tier))))


# --- worker --------------------------------------------------------------------------------------------------------


def worker(names: Sequence[str], result: Path) -> int:
    """Run the named classes one after another in this process, each as its own suite, and write the report.
    The test report goes to stderr, where the parent has pointed both streams at the job's log, so what the
    tests print (progress lines of a long fixture) and the report are in one file in the order they happened."""
    loader = unittest.TestLoader()
    units: dict[str, float] = {}
    tests: dict[str, float] = {}
    failures: list[str] = []
    ran = skipped = 0
    started = time.monotonic()
    runner = unittest.TextTestRunner(stream=sys.stderr, verbosity=2)
    for name in names:
        begin = time.monotonic()
        outcome = runner.run(loader.loadTestsFromName(name))
        units[name] = round(time.monotonic() - begin, 2)
        ran += outcome.testsRun
        skipped += len(outcome.skipped)
        for test, seconds in outcome.collectedDurations:
            tests[test] = round(seconds, 2)
        for kind, found in (("FAIL", outcome.failures), ("ERROR", outcome.errors)):
            failures.extend(f"{kind}: {test}\n{trace}" for test, trace in found)
    body = {
        "units": units,
        "tests": tests,
        "ran": ran,
        "skipped": skipped,
        "failures": failures,
        "wall": round(time.monotonic() - started, 2),
    }
    result.write_text(json.dumps(body), encoding="utf-8")
    return 1 if failures else 0


# --- parent --------------------------------------------------------------------------------------------------------


def worker_env(tier: str) -> dict[str, str]:
    paths = [str(ROOT), str(ROOT / "src"), str(ROOT / ".vendor")]
    env = {**os.environ, "PYTHONPATH": os.pathsep.join(paths), "PYTHONDONTWRITEBYTECODE": "1"}
    if tier in ("integration", "boot"):
        env["DIF_INTEGRATION"] = "1"
    return env


def run_job(job: Job, tier: str, folder: Path, printer: threading.Lock, total: int) -> Outcome:
    log, result = folder / f"job-{job.index}.log", folder / f"job-{job.index}.json"
    command = [sys.executable, str(Path(__file__).resolve()), "worker", str(result), *job.names]
    started = time.monotonic()
    with log.open("w", encoding="utf-8") as stream:
        done = subprocess.run(
            command, cwd=ROOT, env=worker_env(tier), stdout=stream, stderr=subprocess.STDOUT, check=False
        )
    seconds = time.monotonic() - started
    try:
        report: Report | None = parse_report(result.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        report = None
    outcome = Outcome(job, report, done.returncode, log, seconds)
    with printer:
        announce(outcome, total)
    return outcome


def announce(outcome: Outcome, total: int) -> None:
    """The job's log, inside a collapsible group on GitHub Actions, then one line saying how it went."""
    github = os.environ.get("GITHUB_ACTIONS") == "true"
    label = f"job {outcome.job.index + 1}/{total}: {', '.join(short(name) for name in outcome.job.names)}"
    if github:
        print(f"::group::{label}")
    try:
        sys.stdout.write(outcome.log.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        print(f"(no log at {outcome.log})")
    if github:
        print("::endgroup::")
    state = "ok" if outcome.status == 0 else f"FAILED (exit {outcome.status})"
    print(f"== {label}: {state}, {outcome.seconds:.0f} s", flush=True)


def short(name: str) -> str:
    """`tests.integration.test_core_build.CoreBuildTest` as `test_core_build.CoreBuildTest`."""
    return ".".join(name.split(".")[-2:])


def summary(outcomes: Sequence[Outcome], wall: float, workers: int) -> tuple[list[str], int]:
    """The closing lines and the exit status."""
    reports = [one.report for one in outcomes if one.report is not None]
    lost = [one for one in outcomes if one.report is None]
    failures = [text for report in reports for text in report.failures]
    units = {name: seconds for report in reports for name, seconds in report.units.items()}
    tests = {name: seconds for report in reports for name, seconds in report.tests.items()}
    ran = sum(report.ran for report in reports)
    skipped = sum(report.skipped for report in reports)
    busy = sum(units.values())
    lines = ["", "=" * 70]
    for text in failures:
        lines += [text.rstrip(), "-" * 70]
    for one in lost:
        lines.append(f"job {one.job.index + 1} left no report (exit {one.status}); its log is {one.log}")
    lines.append(f"slowest classes (of {len(units)}):")
    lines += [f"  {seconds:7.1f} s  {name}" for name, seconds in top(units)]
    lines.append(f"slowest tests (of {len(tests)}):")
    lines += [f"  {seconds:7.1f} s  {name}" for name, seconds in top(tests)]
    lines.append(
        f"{ran} tests, {len(failures)} failed, {skipped} skipped; {wall:.0f} s wall on {workers} workers, "
        f"{busy:.0f} s of class time ({busy / wall:.1f}x)"
        if wall > 0
        else f"{ran} tests"
    )
    bad = bool(failures or lost or any(one.status != 0 for one in outcomes))
    lines.append("FAILED" if bad else "OK")
    return lines, 1 if bad else 0


def top(seconds: Mapping[str, float]) -> list[tuple[str, float]]:
    return sorted(seconds.items(), key=lambda item: (-item[1], item[0]))[:TOP]


def main(argv: Sequence[str]) -> int:
    if argv and argv[0] == "worker":
        return worker(argv[2:], Path(argv[1]))
    parser = argparse.ArgumentParser(prog="scripts/run-tests", description=__doc__.split("\n")[0])
    parser.add_argument("tier", choices=TIERS)
    parser.add_argument("-j", "--jobs", type=int, default=int(os.environ.get("DIF_JOBS") or 0))
    parser.add_argument("--shard", default="1/1")
    parser.add_argument("--measure", action="store_true")
    parser.add_argument("--list", action="store_true")
    arguments = parser.parse_args(argv)
    cpus = os.process_cpu_count() or 1
    if arguments.jobs > 0:
        workers, why = arguments.jobs, f"{arguments.jobs} workers: -j / DIF_JOBS"
    else:
        workers, why = choose_workers(cpus, available_memory(), BUDGETS[arguments.tier])
    try:
        index, count = parse_shard(arguments.shard)
    except ValueError as error:
        parser.error(str(error))
    sys.path[:0] = [str(ROOT), str(ROOT / "src"), str(ROOT / ".vendor")]
    known = read_durations(DURATIONS.read_text(encoding="utf-8")) if DURATIONS.is_file() else {}
    names = selected(arguments.tier)
    weights = shard_of(weigh(names, known), index, count)
    jobs = batches(weights, workers)
    print(why, flush=True)
    if arguments.list:
        for job in jobs:
            print(f"job {job.index + 1}: {job.weight:7.1f} s  {' '.join(job.names)}")
        print(
            f"{len(weights)} classes, {sum(weights.values()):.0f} s of work, shard {index}/{count}, {workers} workers"
        )
        return 0
    folder = ROOT / "dist" / f"test-{arguments.tier}"
    folder.mkdir(parents=True, exist_ok=True)
    for stale in folder.glob("job-*"):
        stale.unlink()
    printer = threading.Lock()
    started = time.monotonic()
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, min(workers, len(jobs)))) as pool:
        futures = [pool.submit(run_job, job, arguments.tier, folder, printer, len(jobs)) for job in jobs]
        outcomes = [future.result() for future in futures]
    wall = time.monotonic() - started
    (ROOT / "dist" / f"test-{arguments.tier}.log").write_text(
        "".join(one.log.read_text(encoding="utf-8", errors="replace") for one in outcomes if one.log.is_file()),
        encoding="utf-8",
    )
    lines, status = summary(outcomes, wall, workers)
    print("\n".join(lines))
    if arguments.measure:
        fresh = {name: seconds for one in outcomes if one.report for name, seconds in one.report.units.items()}
        merged = {**known, **fresh}
        DURATIONS.write_text(json.dumps({"units": dict(sorted(merged.items()))}, indent=1) + "\n", encoding="utf-8")
        print(f"wrote {DURATIONS.relative_to(ROOT)}")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
